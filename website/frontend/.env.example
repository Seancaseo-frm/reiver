# Frontend (Vite + Vue). Copy to `.env.local` and adjust.
# Public Calendly scheduling URL (full link to your event). Leave unset until Calendly is configured; demo buttons then use mailto fallback.
# VITE_CALENDLY_URL=

# Documentation site origin (no trailing slash). Defaults via .env.production on release builds; for local dev, set in `.env.local`.
# VITE_DOCS_BASE_URL=http://localhost:5174
