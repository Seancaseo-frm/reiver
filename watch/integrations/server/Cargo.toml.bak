[workspace]
members = [
    "webhooks",
    "aws",
    "azure",
    "gcp",
    "oci",
    "snowflake",
    # Future: "log-ingestion", "trace-ingestion"
]
resolver = "2"

[workspace.package]
version = "0.1.0"
edition = "2021"
authors = ["DataHippo Team"]
license = "MIT"
repository = "https://github.com/datahippo/datahippo"

