# Gateway base URL (website that proxies to Flow). Default when running locally.
GATEWAY_URL=http://localhost:3003

# Project API key from Settings > General (or Prompt Hub integrations). Required.
API_KEY=

# Optional: project ID for logging (UUID from the project URL).
# PROJECT_ID=9b1eace6-b3f2-459a-a3dd-3cb3712e3f64
