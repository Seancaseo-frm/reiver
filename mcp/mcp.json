{
  "mcpServers": {
    "reiver": {
      "command": "reiver-mcp",
      "args": ["--transport", "stdio"],
      "env": {
        "REIVER_API_KEY": "<your-agent-token>",
        "WEBSITE_URL": "https://reiver.ai",
        "FLOW_URL": "https://reiver.ai",
        "WATCH_URL": "https://reiver.ai"
      }
    }
  }
}
