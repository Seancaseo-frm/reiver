{
  "mcpServers": {
    "reiver": {
      "command": "reiver-mcp",
      "args": ["--transport", "stdio"],
      "env": {
        "REIVER_API_KEY": "<your-project-api-key>",
        "WEBSITE_URL": "https://app.reiver.io",
        "FLOW_URL": "https://flow.reiver.io",
        "WATCH_URL": "https://watch.reiver.io"
      }
    }
  }
}
